 logger = init_logger(__name__)
 
+# ---------------------------------------------------------------------------
+# DGX Spark (SM12x) dense-layer MXFP4 quantization, ported from the
+# christopherowen/vllm fork (commits 0020c0a35..bb31e66e6). Runtime-quantizes
+# the bf16 qkv/o/lm_head weights of gpt-oss checkpoints to MXFP4 and runs them
+# through the Marlin fused dequant+GEMM kernel (4x less weight traffic).
+# Enabled via VLLM_SPARK_DENSE="qkv,o,lm_head" (any subset).
+# ---------------------------------------------------------------------------
+import os as _os
 
+
+def _spark_dense_layers() -> set[str]:
+    raw = _os.environ.get("VLLM_SPARK_DENSE", "")
+    return {t.strip() for t in raw.split(",") if t.strip()}
+
+
+def _mxfp4_e2m1_quantize(x: torch.Tensor) -> tuple[torch.Tensor, torch.Tensor]:
+    """Quantize [N, K] bf16 weights to packed MXFP4 (uint8) + E8M0 scales,
+    linear (non-swizzled) scale layout for Marlin compatibility."""
+    from flashinfer import fp4_quantize
+
+    device = x.device
+    max_val = x.abs().max()
+    if not torch.isfinite(max_val):
+        max_val = x.float().abs().nan_to_num().max()
+    max_val_f32 = torch.clamp(max_val.float(), min=1e-30)
+    global_scale = ((448 * 6) / max_val_f32).to(device=device, dtype=torch.float32)
+    x_q, x_scales = fp4_quantize(
+        x,
+        global_scale,
+        sf_vec_size=32,
+        sf_use_ue8m0=True,
+        is_sf_swizzled_layout=False,
+    )
+    if x_scales.ndim == 1:
+        x_scales = x_scales.view(x.size(0), -1)
+    return x_q, x_scales
+
+
+
+class SparkMxfp4LinearMethod(UnquantizedLinearMethod):
+    """MXFP4 linear (qkv/o) via runtime quantization + Marlin dequant-GEMM."""
+
+    def create_weights(
+        self,
+        layer: torch.nn.Module,
+        input_size_per_partition: int,
+        output_partition_sizes: list[int],
+        input_size: int,
+        output_size: int,
+        params_dtype: torch.dtype,
+        **extra_weight_attrs,
+    ):
+        from vllm.model_executor.parameter import ModelWeightParameter
+
+        output_size_per_partition = sum(output_partition_sizes)
+        weight_loader = extra_weight_attrs.pop("weight_loader", None)
+        assert weight_loader is not None
+        layer.input_size_per_partition = input_size_per_partition
+        layer.output_size_per_partition = output_size_per_partition
+        layer.params_dtype = params_dtype
+        weight = ModelWeightParameter(
+            data=torch.empty(
+                output_size_per_partition,
+                input_size_per_partition,
+                dtype=params_dtype,
+            ),
+            input_dim=1,
+            output_dim=0,
+            weight_loader=weight_loader,
+        )
+        layer.register_parameter("weight", weight)
+        set_weight_attrs(weight, extra_weight_attrs)
+
+    def process_weights_after_loading(self, layer: torch.nn.Module) -> None:
+        from vllm.model_executor.layers.quantization.utils.marlin_utils_fp4 import (
+            prepare_fp4_layer_for_marlin,
+        )
+
+        weight_fp4, weight_scale = _mxfp4_e2m1_quantize(layer.weight.data)
+        replace_parameter(layer, "weight", weight_fp4)
+        layer.register_parameter(
+            "weight_scale",
+            torch.nn.Parameter(weight_scale, requires_grad=False),
+        )
+        prepare_fp4_layer_for_marlin(layer)
+
+    def apply(
+        self,
+        layer: torch.nn.Module,
+        x: torch.Tensor,
+        bias: torch.Tensor | None = None,
+    ) -> torch.Tensor:
+        from vllm.model_executor.layers.quantization.utils.marlin_utils_fp4 import (
+            apply_fp4_marlin_linear,
+        )
+
+        return apply_fp4_marlin_linear(
+            input=x,
+            weight=layer.weight,
+            weight_scale=layer.weight_scale,
+            weight_global_scale=None,
+            workspace=layer.workspace,
+            size_n=layer.output_size_per_partition,
+            size_k=layer.input_size_per_partition,
+            bias=bias,
+        )
+
+
+class SparkMxfp4LMHeadMethod(QuantizeMethodBase):
+    """MXFP4 lm_head (VocabParallelEmbedding) via Marlin dequant-GEMM."""
+
+    def create_weights(
+        self,
+        layer: torch.nn.Module,
+        input_size_per_partition: int,
+        output_partition_sizes: list[int],
+        input_size: int,
+        output_size: int,
+        params_dtype: torch.dtype,
+        **extra_weight_attrs,
+    ):
+        output_size_per_partition = sum(output_partition_sizes)
+        layer.input_size_per_partition = input_size_per_partition
+        layer.output_size_per_partition = output_size_per_partition
+        layer.params_dtype = params_dtype
+        weight = torch.nn.Parameter(
+            torch.empty(
+                output_size_per_partition,
+                input_size_per_partition,
+                dtype=params_dtype,
+            ),
+            requires_grad=False,
+        )
+        set_weight_attrs(weight, {"input_dim": 1, "output_dim": 0})
+        layer.register_parameter("weight", weight)
+        set_weight_attrs(weight, extra_weight_attrs)
+        layer._mxfp4_weight_data_ptr = weight.data.data_ptr()
+
+    def process_weights_after_loading(self, layer: torch.nn.Module) -> None:
+        from vllm.model_executor.layers.quantization.utils.marlin_utils_fp4 import (
+            prepare_fp4_layer_for_marlin,
+        )
+
+        original_data_ptr = getattr(layer, "_mxfp4_weight_data_ptr", None)
+        if (
+            original_data_ptr is not None
+            and layer.weight.data.data_ptr() != original_data_ptr
+        ):
+            logger.warning_once(
+                "[SPARK] lm_head weight storage changed after creation "
+                "(tied embeddings?). Skipping MXFP4, lm_head stays BF16."
+            )
+            delattr(layer, "_mxfp4_weight_data_ptr")
+            layer._mxfp4_weight_replaced = True
+            return
+        if hasattr(layer, "_mxfp4_weight_data_ptr"):
+            delattr(layer, "_mxfp4_weight_data_ptr")
+
+        weight_bf16 = layer.weight.data
+        weight_fp4, weight_scale = _mxfp4_e2m1_quantize(weight_bf16)
+        replace_parameter(layer, "weight", weight_fp4)
+        layer.register_buffer("weight_scale", weight_scale)
+        prepare_fp4_layer_for_marlin(layer, input_dtype=layer.params_dtype)
+        # NOTE: plain info(), not info_once() - target and draft lm_head have
+        # identical shapes, so a deduped message would hide the second one.
+        logger.info(
+            "[SPARK] lm_head quantized: %s BF16 -> %s MXFP4 (module %s)",
+            tuple(weight_bf16.shape),
+            tuple(weight_fp4.shape),
+            hex(id(layer)),
+        )
+
+    def apply(
+        self,
+        layer: torch.nn.Module,
+        x: torch.Tensor,
+        bias: torch.Tensor | None = None,
+    ) -> torch.Tensor:
+        if getattr(layer, "_mxfp4_weight_replaced", False):
+            return torch.nn.functional.linear(x, layer.weight, bias)
+        from vllm.model_executor.layers.quantization.utils.marlin_utils_fp4 import (
+            apply_fp4_marlin_linear,
+        )
+
+        return apply_fp4_marlin_linear(
+            input=x,
+            weight=layer.weight,
+            weight_scale=layer.weight_scale,
+            weight_global_scale=None,
+            workspace=layer.workspace,
+            size_n=layer.output_size_per_partition,
+            size_k=layer.input_size_per_partition,
+            bias=bias,
+        )
+
+    def embedding(self, layer: torch.nn.Module, input_: torch.Tensor) -> torch.Tensor:
+        if getattr(layer, "_mxfp4_weight_replaced", False):
+            return torch.nn.functional.embedding(input_, layer.weight)
+        raise RuntimeError(
+            "MXFP4-quantized lm_head cannot be used for embedding lookup."
+        )
+
+
