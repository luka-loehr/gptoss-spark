+# --- SPARK Eagle3-retraining capture (module-level so torch.compile can
+# constant-fold the disabled case away; capture runs use --enforce-eager) ---
+import os as _spark_cap_os
+import time as _spark_cap_time
+
+_SPARK_CAPTURE_DIR = _spark_cap_os.environ.get("VLLM_SPARK_CAPTURE_DIR", "")
+
+
+def _spark_capture(input_ids, positions, aux_hidden_states):
+    try:
+        if input_ids is None or input_ids.shape[0] < 64:
+            return
+        path = "%s/cap_%d_%d.pt" % (
+            _SPARK_CAPTURE_DIR,
+            int(_spark_cap_time.time() * 1000),
+            int(input_ids.shape[0]),
+        )
+        torch.save(
+            {
+                "input_ids": input_ids.detach().cpu(),
+                "positions": positions.detach().cpu(),
+                "aux": torch.cat([t.detach() for t in aux_hidden_states], dim=-1)
+                .to(torch.bfloat16)
+                .cpu(),
+            },
+            path,
+        )
+    except Exception:
+        pass
 
 
